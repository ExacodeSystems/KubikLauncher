/*
 * KubikLauncher: the launcher's look, in Qt Style Sheets.
 *
 * Names between at-signs are filled in by KubikTheme::appStyleSheet: palette
 * colours by their Tailwind names (void.panel, grass.deep, ...) and the three
 * bundled faces (font.display, font.body, font.mono).
 *
 * The look is kubik.gg/launcher's: everything is a block. The rules, and why:
 *   - A surface is a block: 2-3px corners, a 1px border, and a solid lip under
 *     it. Qt Style Sheets have no box-shadow, so the lip is a 4px bottom border
 *     in a darker shade; the website never blurs a shadow either, so nothing is
 *     lost. Painted things (tiles, cards, the title screen) draw the same
 *     pieces with KubikPaint.
 *   - A button is a block you press. While it is held, 3px of its lip become
 *     top margin, so the face sinks into the lip and nothing around it moves.
 *     Every state keeps the same outer height for the same reason.
 *   - A field, a log or a progress bar is a slot: recessed, its top and left
 *     edges in shadow.
 *   - One accent. Grass fills the primary action (Play, the default button)
 *     and marks the current page; its lip is grass's own deep shade. Heart is
 *     for Stop and Delete.
 *   - Focus is a 2px ring: grass on dark buttons, bone on grass ones, because
 *     without it the app cannot be used without a mouse.
 *   - The noon sky is for the title screens alone: the first-run wizard
 *     (SetupWizard), the sign-in page (#kubikTitleScreen) and the rail's head,
 *     each painted with KubikPaint. The pages a player works in stay
 *     underground-dark.
 *
 * Combo boxes and spin boxes keep Fusion's drawing (giving them a QSS border
 * makes Qt stop drawing their arrows); KubikTheme's palette makes their Fusion
 * edges the same tone as their fill, which is what takes the outline away.
 */

* {
    outline: none;
}

QAbstractScrollArea,
QFrame {
    border: none;
}

QToolTip {
    color: @bone@;
    background-color: @void.panel@;
    border: 1px solid @block.edge@;
    padding: 5px 8px;
}

/* ── Buttons ────────────────────────────────────────────────────────────── */

/* The plain block: dark, edged in block.edge, on a near-black lip. Outer height 33px in every state. */
QPushButton {
    color: @bone@;
    background-color: @void.panel@;
    border: 1px solid @block.edge@;
    border-top-color: #3d4b4a;
    border-bottom: 4px solid @block.lip@;
    border-radius: 2px;
    padding: 5px 15px 3px 15px;
    min-height: 20px;
    font-family: "@font.display@";
    font-weight: 600;
}

QPushButton:hover {
    color: #ffffff;
    background-color: @block@;
}

QPushButton:focus {
    border: 2px solid @grass.deep@;
    border-bottom: 4px solid @block.lip@;
    padding: 4px 14px 3px 14px;
}

/* Held (or toggled on): the face sinks 3px into its lip. */
QPushButton:pressed,
QPushButton:checked {
    margin-top: 3px;
    border-bottom-width: 1px;
    background-color: @void.raised@;
}

QPushButton:focus:pressed,
QPushButton:focus:checked {
    margin-top: 3px;
    border-bottom-width: 1px;
}

/* The default action: the one grass block on a screen, lit along its top, on grass's deep lip. */
QPushButton:default,
QPushButton[kubikRole="primary"] {
    color: @void@;
    background-color: @grass.mid@;
    border: none;
    border-top: 1px solid #45c89d;
    border-bottom: 4px solid #046a4d;
    padding: 5px 16px 3px 16px;
}

QPushButton:default:hover,
QPushButton[kubikRole="primary"]:hover {
    color: @void@;
    background-color: @grass@;
    border-top-color: #61ddb0;
}

QPushButton:default:focus,
QPushButton[kubikRole="primary"]:focus {
    border: 2px solid @bone@;
    border-bottom: 4px solid #046a4d;
    padding: 4px 14px 3px 14px;
}

QPushButton:default:pressed,
QPushButton[kubikRole="primary"]:pressed {
    margin-top: 3px;
    border-bottom-width: 1px;
    background-color: @grass@;
}

/* Stop and Delete: the same block in heart, on its own deep lip. */
QPushButton[kubikRole="danger"] {
    color: @void@;
    background-color: @heart@;
    border: none;
    border-top: 1px solid #ff8a8a;
    border-bottom: 4px solid #8f2424;
    padding: 5px 16px 3px 16px;
}

QPushButton[kubikRole="danger"]:hover {
    color: @void@;
    background-color: #ff7070;
}

QPushButton[kubikRole="danger"]:focus {
    border: 2px solid @bone@;
    border-bottom: 4px solid #8f2424;
    padding: 4px 14px 3px 14px;
}

QPushButton[kubikRole="danger"]:pressed {
    margin-top: 3px;
    border-bottom-width: 1px;
    background-color: @heart.deep@;
}

/* A button that reads as a link: back, "Open folder", rows in a list. No block, no lip, nothing sinks. */
QPushButton[kubikRole="quiet"] {
    color: @bone.muted@;
    background-color: transparent;
    border: none;
    margin: 0;
    padding: 6px 14px 7px 14px;
}

QPushButton[kubikRole="quiet"]:hover {
    color: @bone@;
    background-color: @void.panel@;
}

QPushButton[kubikRole="quiet"]:pressed {
    margin: 0;
    border: none;
    background-color: @void.raised@;
}

QPushButton[kubikRole="quiet"]:focus {
    border: 2px solid @grass.deep@;
    padding: 4px 12px 5px 12px;
}

/* A quiet button that is the default (Cancel on "Delete …?") keeps its quiet look; only the role decides colour. */
QPushButton[kubikRole="quiet"]:default {
    color: @bone.muted@;
    background-color: transparent;
    border: none;
}

/* A button that is a sentence's link: "How to join", "Show Java arguments". Flush with the text
   column (no padding), in the accent, and it lights up rather than filling. */
QPushButton[kubikRole="link"] {
    color: @grass@;
    background-color: transparent;
    border: none;
    margin: 0;
    padding: 4px 0;
}

QPushButton[kubikRole="link"]:hover {
    color: @grass.mid@;
    background-color: transparent;
}

QPushButton[kubikRole="link"]:pressed {
    margin: 0;
    border: none;
    background-color: transparent;
}

QPushButton[kubikRole="link"]:focus {
    border: none;
    padding: 4px 0;
    text-decoration: underline;
}

/* Out of reach: still a block, gone flat and dim. */
QPushButton:disabled,
QPushButton:default:disabled,
QPushButton[kubikRole="primary"]:disabled,
QPushButton[kubikRole="danger"]:disabled {
    color: @bone.faint@;
    background-color: @void.raised@;
    border: 1px solid @block@;
    border-bottom: 4px solid @block.lip@;
    padding: 5px 15px 3px 15px;
}

QPushButton[kubikRole="quiet"]:disabled,
QPushButton[kubikRole="link"]:disabled {
    color: @bone.faint@;
    background-color: transparent;
    border: none;
}

QPushButton::menu-indicator {
    subcontrol-position: right center;
    right: 8px;
}

QToolButton {
    color: @bone@;
    background-color: transparent;
    border: none;
    border-radius: 2px;
    padding: 4px;
}

QToolButton:hover {
    background-color: @block@;
}

QToolButton:pressed,
QToolButton:checked {
    background-color: @void.panel@;
}

/* ── Fields: slots, pressed into the surface ────────────────────────────── */

QLineEdit,
QPlainTextEdit,
QTextEdit,
QTextBrowser {
    color: @bone@;
    background-color: @void.raised@;
    border: 2px solid @block@;
    border-top-color: @block.deep@;
    border-left-color: @block.deep@;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: rgba(52, 211, 153, 0.28);
    selection-color: @bone@;
}

QLineEdit:hover,
QPlainTextEdit:hover,
QTextEdit:hover {
    border-right-color: @block.edge@;
    border-bottom-color: @block.edge@;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border-color: @grass.deep@;
}

QLineEdit:disabled {
    color: @bone.faint@;
}

/* A progress bar is a slot that fills with grass, square-ended like a block. */
QProgressBar {
    color: @bone@;
    background-color: @void@;
    border: 1px solid @block@;
    border-top-color: @block.deep@;
    border-left-color: @block.deep@;
    border-radius: 2px;
    text-align: center;
    min-height: 8px;
}

QProgressBar::chunk {
    background-color: @grass@;
    border-bottom: 2px solid @grass.deep@;
    border-radius: 0;
}

/* ── Lists, tables, trees ───────────────────────────────────────────────── */

QAbstractItemView {
    background-color: @void@;
    alternate-background-color: @void.raised@;
    selection-background-color: @block@;
    selection-color: @bone@;
}

QAbstractItemView::item {
    padding: 4px 6px;
}

QAbstractItemView::item:hover {
    background-color: @void.panel@;
}

QAbstractItemView::item:selected {
    color: @bone@;
    background-color: @block@;
}

QHeaderView,
QHeaderView::section {
    color: @bone.muted@;
    background-color: @void@;
    border: none;
    padding: 3px 8px;
    font-weight: 600;
}

/* ── Check boxes and radio buttons: filled shapes that read on the dark ground ── */

QCheckBox::indicator,
QGroupBox::indicator,
QAbstractItemView::indicator,
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: @block@;
    border: none;
    border-radius: 2px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    background-color: @block.edge@;
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QAbstractItemView::indicator:checked {
    background-color: @grass@;
    image: url(:/kubik/check.svg);
}

QCheckBox::indicator:indeterminate {
    background-color: @grass.deep@;
}

/* A selected radio is a grass ring around a dark dot: 5 + 6 + 5 = the same 16px. */
QRadioButton::indicator:checked {
    background-color: @void@;
    border: 5px solid @grass@;
    width: 6px;
    height: 6px;
}

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    background-color: @void.panel@;
}

QTableCornerButton::section {
    background-color: @void@;
    border: none;
}

/* ── Bars and menus ─────────────────────────────────────────────────────── */

QMenuBar {
    background-color: @void.raised@;
}

QMenuBar::item:selected {
    background-color: @block@;
}

QToolBar {
    background-color: @void.raised@;
    border: none;
    spacing: 4px;
    padding: 6px;
}

QToolBar QToolButton {
    padding: 6px 10px;
    font-family: "@font.display@";
    font-weight: 600;
}

QStatusBar {
    color: @bone.muted@;
    background-color: @void.raised@;
    border: none;
}

/* A menu is a panel: edged in block.edge, standing on its lip. */
QMenu {
    color: @bone@;
    background-color: @void.panel@;
    border: 1px solid @block.edge@;
    border-bottom: 4px solid @block.lip@;
    padding: 6px;
}

QMenu::item {
    padding: 7px 28px 7px 28px;
    border-radius: 2px;
}

QMenu::item:selected {
    background-color: @block@;
}

QMenu::item:disabled {
    color: @bone.faint@;
}

QMenu::separator {
    height: 6px;
    background: transparent;
}

/* ── Tabs, groups ───────────────────────────────────────────────────────── */

QTabWidget::pane {
    background-color: transparent;
    border: none;
}

QTabBar::tab {
    color: @bone.muted@;
    background-color: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    padding: 8px 14px;
    margin-right: 4px;
    font-family: "@font.display@";
    font-weight: 600;
}

QTabBar::tab:selected {
    color: @bone@;
    border-bottom-color: @grass@;
}

QTabBar::tab:hover:!selected {
    color: @bone@;
}

/* A group box is a heading and the space under it, not a box. */
QGroupBox {
    border: none;
    margin-top: 22px;
    padding-top: 4px;
    font-family: "@font.display@";
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0;
    padding: 0;
    color: @bone@;
}

/* ── Scroll bars: a handle, no track ────────────────────────────────────── */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
    border: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: @block@;
    min-height: 32px;
    border-radius: 1px;
}

QScrollBar::handle:horizontal {
    background-color: @block@;
    min-width: 32px;
    border-radius: 1px;
}

QScrollBar::handle:hover {
    background-color: @block.edge@;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}

/* ── The shell (ui/kubik/) ──────────────────────────────────────────────── */

#kubikSidebar,
#kubikSettingsNav {
    background-color: @void.raised@;
}

#kubikBrandName {
    color: @bone@;
    font-family: "@font.display@";
    font-size: 19px;
    font-weight: 700;
}

/* Rail rows: no block, a filled row for the current page with a grass bar on
   its left edge. They are places, not actions, so they do not sink. */
#kubikSidebar QPushButton,
#kubikSettingsNav QPushButton {
    color: @bone.muted@;
    background-color: transparent;
    border: none;
    border-left: 4px solid transparent;
    border-radius: 0;
    margin: 0;
    padding: 10px 16px 10px 14px;
    text-align: left;
    font-family: "@font.display@";
    font-size: 15px;
    font-weight: 600;
}

#kubikSidebar QPushButton:hover,
#kubikSettingsNav QPushButton:hover {
    color: @bone@;
    background-color: @void.panel@;
}

#kubikSidebar QPushButton:checked,
#kubikSettingsNav QPushButton:checked {
    color: @bone@;
    background-color: @void.panel@;
    border-left-color: @grass@;
}

#kubikSidebar QPushButton::menu-indicator {
    image: none;
    width: 0;
}

/* A heading inside a dropdown (the profile card's "Minecraft", "kubik.gg"): a label, not an action. */
#kubikMenuHeader {
    color: @bone.faint@;
    font-family: "@font.display@";
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px 2px 12px;
}

#kubikPage {
    background-color: @void@;
}

#kubikPageTitle {
    color: @bone@;
    font-family: "@font.display@";
    font-size: 30px;
    font-weight: 700;
}

#kubikPageSubtitle,
#kubikPageBody {
    color: @bone.muted@;
    font-size: 14px;
}

/* A sentence that says something went wrong, where the action was. */
#kubikPageError {
    color: @heart@;
    font-size: 14px;
}

#kubikSectionTitle {
    color: @bone@;
    font-family: "@font.display@";
    font-size: 17px;
    font-weight: 700;
}

/* A section's kicker: words in grass after a small shaded grass block (KubikEyebrow draws the block). */
#kubikEyebrow {
    color: @grass@;
    font-family: "@font.display@";
    font-size: 13px;
    font-weight: 600;
}

#kubikSearch {
    min-width: 220px;
    padding: 6px 10px;
}

/* The big action of a page (Play, Sign in): the same block, larger. Outer height 46px. */
QPushButton#kubikHeroPlay {
    font-size: 16px;
    font-weight: 700;
    padding: 10px 36px 8px 36px;
    min-width: 120px;
}

QPushButton#kubikHeroPlay:focus {
    padding: 9px 34px 8px 34px;
}

/* A sleeping server's "Wake it up on kubik.gg", beside Play: the same height, as the plain block. */
QPushButton#kubikWake {
    font-size: 16px;
    padding: 10px 24px 8px 24px;
}

QPushButton#kubikWake:focus {
    padding: 9px 23px 8px 23px;
}

/* A row in the instance page's "Manage" list: a block panel that lights up and sinks when pressed. */
QPushButton[kubikRole="row"] {
    color: @bone@;
    background-color: @void.panel@;
    border: 1px solid @block@;
    border-bottom: 4px solid @block.lip@;
    border-radius: 3px;
    padding: 13px 16px 10px 16px;
    /* Two lines of text inside. A style-sheet min-height beats setMinimumHeight(), so it lives here. */
    min-height: 48px;
    text-align: left;
    font-family: "@font.body@";
    font-weight: 400;
}

QPushButton[kubikRole="row"]:hover {
    background-color: @block@;
    border-top-color: @block.edge@;
    border-left-color: @block.edge@;
    border-right-color: @block.edge@;
}

QPushButton[kubikRole="row"]:pressed {
    margin-top: 3px;
    border-bottom-width: 1px;
}

/* A server's or an instance's picture: painted with its own slot frame (KubikPaint::drawSlotFrame). */
#kubikArt {
    background-color: transparent;
}

/* ── First run and small dialogs ────────────────────────────────────────── */

/* "Step 1 of 2": the wizard's kicker, set like the website's eyebrow. */
#kubikStepLabel {
    color: @grass@;
    font-family: "@font.display@";
    font-size: 13px;
    font-weight: 600;
}

/* A quiet aside under the actions: what happens next, never what to do. */
#kubikPageNote {
    color: @bone.faint@;
    font-size: 13px;
}

#kubikDialogTitle {
    color: @bone@;
    font-family: "@font.display@";
    font-size: 20px;
    font-weight: 700;
}

/* The server page's address: an inventory slot, the one thing a player may have to type. */
#kubikAddressCard {
    background-color: @void@;
    border: 2px solid @block@;
    border-top-color: @block.deep@;
    border-left-color: @block.deep@;
    border-radius: 2px;
}

#kubikAddressLabel {
    color: @bone.faint@;
    font-family: "@font.display@";
    font-size: 12px;
    font-weight: 600;
}

#kubikAddress {
    color: @bone@;
    font-family: "@font.mono@";
    font-size: 22px;
    font-weight: 600;
}

#kubikAddressPort {
    color: @bone.muted@;
    font-family: "@font.mono@";
    font-size: 14px;
}

/* "How to join": a block panel a step, its picture on top, a numbered grass block beside its title. */
#kubikJoinStep {
    background-color: @void.panel@;
    border: 1px solid @block@;
    border-bottom: 4px solid @block.lip@;
    border-radius: 3px;
}

#kubikStepNumber {
    color: @void@;
    background-color: @grass@;
    border-bottom: 3px solid #046a4d;
    border-radius: 2px;
    font-family: "@font.display@";
    font-size: 14px;
    font-weight: 700;
}

#kubikStepTitle {
    color: @bone@;
    font-family: "@font.display@";
    font-size: 15px;
    font-weight: 600;
}

/* Settings › Profiles, and the sign-in page's Minecraft account: one block panel per profile. */
#kubikProfileRow {
    background-color: @void.panel@;
    border: 1px solid @block@;
    border-bottom: 4px solid @block.lip@;
    border-radius: 3px;
}

/* A step that worked, said where it is shown: the sign-in page's connected Minecraft account. */
#kubikStateOk {
    color: @grass@;
    font-size: 14px;
    font-weight: 600;
}

/* The memory slider: a slot for a track, filled with grass up to a block for a handle. */
QSlider#kubikMemory::groove:horizontal {
    height: 8px;
    background-color: @void@;
    border: 1px solid @block@;
    border-top-color: @block.deep@;
    border-radius: 2px;
}

QSlider#kubikMemory::sub-page:horizontal {
    background-color: @grass@;
    border-radius: 1px;
}

QSlider#kubikMemory::sub-page:horizontal:disabled {
    background-color: @block.edge@;
}

QSlider#kubikMemory::handle:horizontal:disabled {
    background-color: @bone.faint@;
}

QSlider#kubikMemory::handle:horizontal {
    width: 14px;
    height: 20px;
    margin: -8px 0;
    background-color: @bone@;
    border-bottom: 3px solid @stone@;
    border-radius: 2px;
}

/* Home's "Jump back in": the chosen server, so its block stands on grass's lip. */
#kubikHero {
    background-color: @void.panel@;
    border: 1px solid @block.edge@;
    border-bottom: 4px solid #046a4d;
    border-radius: 3px;
}

#kubikHeroName {
    color: @bone@;
    font-family: "@font.display@";
    font-size: 26px;
    font-weight: 700;
}

#kubikHero QPushButton#kubikHeroPlay {
    padding: 8px 30px 6px 30px;
}

#kubikHero QPushButton#kubikHeroPlay:focus {
    padding: 7px 28px 6px 28px;
}

/* A log: the install details on a server page, the Logs tab of an instance. Mono, in a slot. */
QPlainTextEdit#kubikLog {
    color: @bone.muted@;
    background-color: @void@;
    border: 2px solid @block@;
    border-top-color: @block.deep@;
    border-left-color: @block.deep@;
    border-radius: 2px;
    padding: 6px 8px;
}

/* An instance page's tabs: words with a grass bar under the current one, no box. */
QPushButton#kubikTab {
    color: @bone.muted@;
    background-color: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    border-radius: 0;
    margin: 0;
    padding: 6px 0;
    font-family: "@font.display@";
    font-size: 15px;
    font-weight: 600;
}

QPushButton#kubikTab:hover {
    color: @bone@;
    background-color: transparent;
}

QPushButton#kubikTab:checked {
    color: @bone@;
    background-color: transparent;
    border-bottom-color: @grass@;
}

QPushButton#kubikTab:focus {
    padding: 6px 0;
}

/* The Mods tab's list: rows paint themselves (KubikModDelegate), so the view adds nothing. */
QListView#kubikModList,
QListView#kubikModList::item,
QListView#kubikModList::item:hover {
    background-color: transparent;
}

/* Prism's instance window ("More settings"): its page list styled like the rail and the Settings nav. */
QListView#kubikPageList {
    background-color: @void.raised@;
}

QListView#kubikPageList::item {
    color: @bone.muted@;
    border-left: 4px solid transparent;
    padding: 8px 12px;
}

QListView#kubikPageList::item:hover {
    color: @bone@;
    background-color: @void.panel@;
}

QListView#kubikPageList::item:selected {
    color: @bone@;
    background-color: @void.panel@;
    border-left-color: @grass@;
}

/* ── The title screen: words on the noon sky ──────────────────────────────
   KubikSignInPage and the setup wizard's own pages (SetupWizard paints their
   sky). Bone and grass do not read on it, so its words are in dark ink. */

#kubikTitleScreen QLabel#kubikPageTitle,
#SetupWizard QLabel#kubikPageTitle {
    color: @void@;
}

#kubikTitleScreen QLabel#kubikPageTitle {
    font-size: 32px;
}

#kubikTitleScreen QLabel#kubikPageBody,
#SetupWizard QLabel#kubikPageBody {
    color: #13213a;
    font-size: 15px;
}

#SetupWizard QLabel#kubikPageNote {
    color: #2c3d5c;
}

/* The kicker in grass's deepest shade: grass itself is too light on the sky. */
#SetupWizard QLabel#kubikStepLabel {
    color: #046a4d;
}

/* Heart's red is too light for the sky; this is the same red, darkened until it reads there. */
#kubikTitleScreen QLabel#kubikPageError {
    color: #8f1d1d;
    font-weight: 600;
}

#kubikTitleScreen QPushButton[kubikRole="quiet"],
#SetupWizard QPushButton[kubikRole="quiet"] {
    color: #13213a;
}

#kubikTitleScreen QPushButton[kubikRole="quiet"]:hover,
#SetupWizard QPushButton[kubikRole="quiet"]:hover {
    color: @void@;
    background-color: rgba(255, 255, 255, 0.35);
}

#kubikTitleScreen QPushButton[kubikRole="quiet"]:focus,
#SetupWizard QPushButton[kubikRole="quiet"]:focus {
    border-color: @void@;
}
