<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/kubik">
        <!-- Generated in the kubik.gg repo by the art:launcher script in apps/mobile. -->
        <file>tokens.json</file>
        <file>kubik.qss</file>
        <file>check.svg</file>
        <!-- The website's three faces, under the SIL Open Font License (fonts/OFL-*.txt). -->
        <file>fonts/ChakraPetch-Medium.ttf</file>
        <file>fonts/ChakraPetch-SemiBold.ttf</file>
        <file>fonts/ChakraPetch-Bold.ttf</file>
        <file>fonts/HankenGrotesk[wght].ttf</file>
        <file>fonts/JetBrainsMono[wght].ttf</file>
        <file>fonts/OFL-ChakraPetch.txt</file>
        <file>fonts/OFL-HankenGrotesk.txt</file>
        <file>fonts/OFL-JetBrainsMono.txt</file>
    </qresource>
    <!-- English and Indonesian, compiled by i18n/build.sh (TranslationsModel's bundled mode). -->
    <qresource prefix="/kubik/i18n">
        <file alias="prism_id.qm">i18n/prism_id.qm</file>
        <file alias="kubik_id.qm">i18n/kubik_id.qm</file>
        <file alias="kubik_en.qm">i18n/kubik_en.qm</file>
    </qresource>
    <!-- The Kubik resource pack KubikSyncTask copies into each instance (kubik/KubikGameFiles.h). Its art is
         generated by the art:launcher script in the kubik.gg repo; splashes.txt is written here. A panorama, once
         captured, adds textures/gui/title/background/panorama_0..5.png. -->
    <qresource prefix="/kubik/resourcepack">
        <file alias="pack.png">resourcepack/pack.png</file>
        <file alias="assets/minecraft/texts/splashes.txt">resourcepack/assets/minecraft/texts/splashes.txt</file>
        <file alias="assets/minecraft/textures/gui/menu_background.png">resourcepack/assets/minecraft/textures/gui/menu_background.png</file>
        <file alias="assets/minecraft/textures/gui/menu_list_background.png">resourcepack/assets/minecraft/textures/gui/menu_list_background.png</file>
        <file alias="assets/minecraft/textures/gui/inworld_menu_background.png">resourcepack/assets/minecraft/textures/gui/inworld_menu_background.png</file>
        <file alias="assets/minecraft/textures/gui/inworld_menu_list_background.png">resourcepack/assets/minecraft/textures/gui/inworld_menu_list_background.png</file>
        <file alias="assets/minecraft/textures/gui/header_separator.png">resourcepack/assets/minecraft/textures/gui/header_separator.png</file>
        <file alias="assets/minecraft/textures/gui/footer_separator.png">resourcepack/assets/minecraft/textures/gui/footer_separator.png</file>
        <file alias="assets/minecraft/textures/gui/inworld_header_separator.png">resourcepack/assets/minecraft/textures/gui/inworld_header_separator.png</file>
        <file alias="assets/minecraft/textures/gui/inworld_footer_separator.png">resourcepack/assets/minecraft/textures/gui/inworld_footer_separator.png</file>
    </qresource>
</RCC>
